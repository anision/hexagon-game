# =====================================================
# Hexagon Game — Environment Variables
# Copy this file to .env and fill in the values
# =====================================================

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/hexagon

# Security
SECRET_KEY=change-me-to-a-long-random-secret-key

# Google OAuth2 — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Ports (dev only — not used in production)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Origin for post-login redirects
# Dev:  http://localhost:3000
# Prod: http://SEU_IP  (nginx serves on port 80)
ALLOWED_ORIGIN=http://localhost:3000
