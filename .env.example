# =====================================================
# Hexagon Game — Environment Variables
# Copy this file to .env and fill in the values
# =====================================================

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/hexagon

# Security
SECRET_KEY=change-me-to-a-long-random-secret-key

# Google OAuth2 — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# CORS (production: set to your domain)
ALLOWED_ORIGIN=http://localhost:3000
